@model WebApplication.Data.Models.Car

@{
    ViewData["Title"] = "Додати авто";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Нове оголошення</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Model" class="form-label"></label>
                                <input asp-for="Model" class="form-control" />
                                <span asp-validation-for="Model" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Price" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="Price" class="form-control" type="number" step="0.01" />
                                </div>
                            </div>
                            
                            <div class="col-md-4">
                                <label asp-for="Year" class="form-label"></label>
                                <input asp-for="Year" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Mileage" class="form-label"></label>
                                <input asp-for="Mileage" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="EngineVolume" class="form-label"></label>
                                <select asp-for="EngineVolume" class="form-select" asp-items="Html.GetEnumSelectList<WebApplication.Data.Models.EngineVolume>()"></select>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Class" class="form-label"></label>
                                <select asp-for="Class" class="form-select" asp-items="Html.GetEnumSelectList<WebApplication.Data.Models.CarClass>()"></select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Type" class="form-label"></label>
                                <select asp-for="Type" class="form-select" asp-items="Html.GetEnumSelectList<WebApplication.Data.Models.CarType>()"></select>
                            </div>
                             <div class="col-md-4">
                                <label asp-for="Condition" class="form-label"></label>
                                <select asp-for="Condition" class="form-select" asp-items="Html.GetEnumSelectList<WebApplication.Data.Models.CarCondition>()"></select>
                            </div>

                            <div class="col-12">
                                <label asp-for="ImageUrl" class="form-label">Посилання на зображення</label>
                                <input asp-for="ImageUrl" class="form-control" placeholder="https://..." />
                            </div>
                        </div>

                        <div class="mt-4 text-end">
                            <a asp-action="Index" class="btn btn-link text-decoration-none">Скасувати</a>
                            <button type="submit" class="btn btn-primary px-4">Створити</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}