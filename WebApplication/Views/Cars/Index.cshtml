@using WebApplication.Data.Models 
@model PaginatedList<WebApplication.Data.Models.Car>

@{
    ViewData["Title"] = "Каталог Авто";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-6">Наш автопарк</h1>
        <a asp-action="Create" class="btn btn-success"><i class="bi bi-plus-lg"></i> Додати авто</a>
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0">
                    <div style="height: 220px; overflow: hidden; background-color: #f8f9fa; position: relative;">
                        <span class="position-absolute top-0 end-0 badge bg-success m-2 fs-6">
                            @item.Price.ToString("C0")
                        </span>
                        
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" class="card-img-top h-100 w-100" style="object-fit: cover;" alt="@item.Model"
                                 onerror="this.onerror=null;this.src='https://placehold.co/600x400?text=No+Image';">
                        }
                        else
                        {
                            <img src="https://placehold.co/600x400?text=No+Image" class="card-img-top h-100 w-100" style="object-fit: cover;" alt="No image">
                        }
                    </div>

                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <h5 class="card-title fw-bold text-truncate">@item.Model</h5>
                        </div>
                        
                        <div class="card-text text-muted small mt-2">
                            <ul class="list-unstyled mb-0">
                                <li class="mb-1"><i class="bi bi-calendar3"></i> Рік: @item.Year</li>
                                <li class="mb-1"><i class="bi bi-gear-wide-connected"></i> @Html.DisplayFor(m => item.EngineVolume)</li>
                                <li><i class="bi bi-speedometer2"></i> @item.Mileage км</li>
                            </ul>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent border-top-0 pb-3 pt-0">
                        <div class="d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary flex-grow-1">Деталі</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger"><i class="bi bi-trash"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="d-flex justify-content-center mt-5">
        @{
            var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
            var nextDisabled = !Model.HasNextPage ? "disabled" : "";
        }

        <nav aria-label="Page navigation">
            <ul class="pagination">
                <li class="page-item @prevDisabled">
                    <a asp-action="Index"
                       asp-route-pageNumber="@(Model.PageIndex - 1)"
                       class="page-link">
                        &laquo; Попередня
                    </a>
                </li>
                
                <li class="page-item disabled">
                    <span class="page-link text-dark">
                        Сторінка @Model.PageIndex з @Model.TotalPages
                    </span>
                </li>

                <li class="page-item @nextDisabled">
                    <a asp-action="Index"
                       asp-route-pageNumber="@(Model.PageIndex + 1)"
                       class="page-link">
                        Наступна &raquo;
                    </a>
                </li>
            </ul>
        </nav>
    </div>
</div>